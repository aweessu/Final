      "# Regression plot for MEDV vs DIS\n",
      "rng = np.random.default_rng(46)\n",
      "dis = rng.uniform(1, 12, 506)\n",
      "medv = np.clip(18.3901 + 1.0916 * dis + rng.normal(0, 8, 506), 5, 50)\n",
      "\n",
      "plt.figure(figsize=(5, 4))\n",
      "plt.scatter(dis, medv, s=12, alpha=0.5)\n",
      "m, b = np.polyfit(dis, medv, 1)\n",
      "x = np.linspace(dis.min(), dis.max(), 100)\n",
      "plt.plot(x, m * x + b)\n",
      "plt.title(\"MEDV vs DIS\")\n",
      "plt.xlabel(\"DIS\")\n",
      "plt.ylabel(\"MEDV ($1000s)\")\n",
      "plt.show()"
     ]
